POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=movink
POSTGRES_PORT=5432

REDIS_PORT=6379

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/movink
REDIS_URL=redis://localhost:6379/0

CACHE_TTL_SECONDS=60
SSE_HEARTBEAT_SECONDS=15
OUTBOX_POLL_SECONDS=5
OUTBOX_STREAM=dashboard:events
